      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "We calculate mean, median, standard deviation, and the first three simple returns."
      ],
      "metadata": {
        "id": "q3C0W8EZ5O3g"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "prices[\"year\"] = prices[\"Date\"].dt.year\n",
        "\n",
        "annual = prices.groupby(\"year\").agg(\n",
        "    mean_distance=(\"low_vs_dn\", \"mean\"),\n",
        "    median_distance=(\"low_vs_dn\", \"median\"),\n",
        "    min_distance=(\"low_vs_dn\", \"min\"),\n",
        "    std_distance=(\"low_vs_dn\", \"std\")\n",
        ")\n",
        "print(annual)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "YYqYYnP5y7IC",
        "outputId": "40ffcb18-42a4-4590-b0a1-dcac60fbee1e"
